const int SHOCK_PIN = 4; // GPIO pin connected to your relay or MOSFET
const unsigned long MAX_SHOCK_TIME_MS = 1500; // Auto-shutoff safety (1.5 seconds)

unsigned long shockStartTime = 0;
bool isShocking = false;

void setup() {
  // Initialize Serial communication. Python MUST use this same baud rate.
  Serial.begin(115200);
  
  pinMode(SHOCK_PIN, OUTPUT);
  digitalWrite(SHOCK_PIN, LOW); // Always start in a safe (off) state
}

void loop() {
  // 1. Listen for signals from the Python script
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    command.trim(); // Removes invisible carriage returns or spaces

    if (command == "on") {
      digitalWrite(SHOCK_PIN, HIGH);
      isShocking = true;
      shockStartTime = millis(); // Start the safety timer
    } 
    else if (command == "off") {
      digitalWrite(SHOCK_PIN, LOW);
      isShocking = false;
    }
  }

  // 2. Hardware safety timeout
  // If the shock is on longer than the max allowed time, force it off.
  if (isShocking && (millis() - shockStartTime >= MAX_SHOCK_TIME_MS)) {
    digitalWrite(SHOCK_PIN, LOW);
    isShocking = false;
  }
}